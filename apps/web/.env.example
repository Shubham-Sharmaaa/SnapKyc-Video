# Signaling server (apps/signal). Use wss:// in production.
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# Shared with apps/signal: signs short-lived call-room tokens.
SIGNAL_SECRET=change-me
# Signs staff and customer session cookies.
AUTH_SECRET=change-me
# Signs the KYC token given to the customer.
KYC_TOKEN_SECRET=change-me

# Supabase project -> Project Settings -> API. The service-role key must stay
# on the server; it is never sent to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional, defaults to kyc-media.
# SUPABASE_BUCKET=kyc-media

# Optional TURN relay (Metered Open Relay). Without it only STUN is used,
# which is fine on one network but often fails across networks.
METERED_DOMAIN=your-app.metered.live
METERED_TURN_API_KEY=
