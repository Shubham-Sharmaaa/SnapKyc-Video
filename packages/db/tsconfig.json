{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // Just-in-Time package: the web app's bundler compiles the source, so
    // resolve imports the way a bundler does and never emit.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src"]
}
